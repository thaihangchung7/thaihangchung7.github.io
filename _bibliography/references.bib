}

@article{uberuaga_structureproperty_2025,
	title = {On the {Structure}–{Property} {Relationship} of {Semi}‐{Coherent} {FeCr}$_{\textrm{2}}$ {O}$_{\textrm{4}}$ /{Cr}$_{\textrm{2}}$ {O}$_{\textrm{3}}$ {Spinel}/{Corundum} {Interfaces}},
