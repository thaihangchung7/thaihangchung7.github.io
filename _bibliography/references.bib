	author = {Čížek, Jakub and Vlasák, Tomáš and Melikhova, Oksana},
	year = {2022},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/pssa.202100840},
	keywords = {high-entropy alloys, positron annihilation, vacancies},
	pages = {2100840},
	file = {Full Text PDF:C\:\\Users\\thaih\\Zotero\\storage\\VGVN2AE3\\Čížek et al. - 2022 - Characterization of Lattice Defects in Refractory .pdf:application/pdf;Snapshot:C\:\\Users\\thaih\\Zotero\\storage\\M2RQHVND\\pssa.html:text/html},
