	url = {https://dx.doi.org/10.1088/0953-8984/19/13/136205},
	doi = {10.1088/0953-8984/19/13/136205},
	abstract = {Real-time positron annihilation spectroscopy has been applied for the first time for the investigation of lattice vacancies produced during ion irradiation. Measurements were performed for thin nickel foils irradiated with 2.5 MeV C ions. Doppler broadenings of positron annihilation γ-rays were measured alternately during beam-on and beam-off conditions. It was found that the Doppler broadening line-shape parameter measured during irradiation is larger than those obtained before and after irradiation. This evidently implies that transient or non-survivable vacancy defects are produced during ion irradiation. On the other hand, no such significant change in the line-shape parameter was observed for other face-centred-cubic metal forms of aluminium.},
	language = {en},
