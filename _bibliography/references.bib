@article{cizek_characterization_2022-1,
	title = {Characterization of {Lattice} {Defects} in {Refractory} {Metal} {High}-{Entropy} {Alloy} {HfNbTaTiZr} by {Means} of {Positron} {Annihilation} {Spectroscopy}},
