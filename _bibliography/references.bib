	file = {APS Snapshot:C\:\\Users\\thaih\\Zotero\\storage\\QYPDIKBC\\PhysRevA.104.html:text/html;Full Text:C\:\\Users\\thaih\\Zotero\\storage\\8GZ4YS6N\\Mitra et al. - 2021 - Towards \$CP\$-violation studies on superheavy molec.pdf:application/pdf},
}

