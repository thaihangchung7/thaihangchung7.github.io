	doi = {10.1139/p83-120},
	abstract = {Positron motion has been observed in potassium, sodium, magnesium, and aluminum over a wide range of temperatures. The observations show that positrons are close to thermal equilibrium before annihilation even at liquid helium temperature. If a Gaussian momentum distribution is fitted to the data, it yields a positron apparent mass m*/m of 1.6 ± 0.1 in K, 1.55 ± 0.1 in Na, 1.2 ± 0.1 in Mg, and 1.3 ± 0.1 in Al. These new results are fairly close to the theoretical expectations, but show that the subject is not yet fully understood.},
