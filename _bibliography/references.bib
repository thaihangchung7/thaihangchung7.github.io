@article{amsler_pulsed_2021,
	title = {Pulsed production of antihydrogen},
	volume = {4},
	copyright = {2021 The Author(s)},
	issn = {2399-3650},
	url = {https://www.nature.com/articles/s42005-020-00494-z},
	doi = {10.1038/s42005-020-00494-z},
	abstract = {Antihydrogen atoms with K or sub-K temperature are a powerful tool to precisely probe the validity of fundamental physics laws and the design of highly sensitive experiments needs antihydrogen with controllable and well defined conditions. We present here experimental results on the production of antihydrogen in a pulsed mode in which the time when 90\% of the atoms are produced is known with an uncertainty of {\textasciitilde}250 ns. The pulsed source is generated by the charge-exchange reaction between Rydberg positronium atoms—produced via the injection of a pulsed positron beam into a nanochanneled Si target, and excited by laser pulses—and antiprotons, trapped, cooled and manipulated in electromagnetic traps. The pulsed production enables the control of the antihydrogen temperature, the tunability of the Rydberg states, their de-excitation by pulsed lasers and the manipulation through electric field gradients. The production of pulsed antihydrogen is a major landmark in the AE \$\${\textbackslash}bar\{g\}\$\$ IS experiment to perform direct measurements of the validity of the Weak Equivalence Principle for antimatter. Antihydrogen atoms are a unique type of antimatter that can be used to probe small violations of fundamental laws of physics. The authors present experimental results obtained with the AEgIS project at CERN for the production of antihydrogen atoms (Hbar) via charge exchange with laser excited positronium that allow for precise timing of Hbar production.},
	language = {en},
	number = {1},
	urldate = {2025-10-06},
	journal = {Commun Phys},
	publisher = {Nature Publishing Group},
	author = {Amsler, Claude and Antonello, Massimiliano and Belov, Alexander and Bonomi, Germano and Brusa, Roberto Sennen and Caccia, Massimo and Camper, Antoine and Caravita, Ruggero and Castelli, Fabrizio and Cheinet, Patrick and Comparat, Daniel and Consolati, Giovanni and Demetrio, Andrea and Di Noto, Lea and Doser, Michael and Fanì, Mattia and Ferragut, Rafael and Fesel, Julian and Gerber, Sebastian and Giammarchi, Marco and Gligorova, Angela and Glöggler, Lisa Theresa and Guatieri, Francesco and Haider, Stefan and Hinterberger, Alexander and Kellerbauer, Alban and Khalidova, Olga and Krasnický, Daniel and Lagomarsino, Vittorio and Malbrunot, Chloé and Mariazzi, Sebastiano and Matveev, Viktor and Müller, Simon and Nebbia, Giancarlo and Nedelec, Patrick and Nowak, Lilian and Oberthaler, Markus and Oswald, Emmanuel and Pagano, Davide and Penasa, Luca and Petracek, Vojtech and Povolo, Luca and Prelz, Francesco and Prevedelli, Marco and Rienäcker, Benjamin and Røhne, Ole and Rotondi, Alberto and Sandaker, Heidi and Santoro, Romualdo and Testera, Gemma and Tietje, Ingmari and Toso, Valerio and Wolz, Tim and Yzombard, Pauline and Zimmer, Christian and Zurlo, Nicola},
