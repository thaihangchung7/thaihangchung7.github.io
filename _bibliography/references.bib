	keywords = {Metals and alloys, Synthesis and processing},
	pages = {1--18},
	file = {Full Text:C\:\\Users\\thaih\\Zotero\\storage\\ET6ZPVI2\\Qiu et al. - 2017 - Corrosion of high entropy alloys.pdf:application/pdf},
}

