	month = mar,
	year = {2010},
	keywords = {Positron, Defect, Deformation twinning, Dislocation, EBSD, Grain fragmentation, TEM, Zirconium},
	pages = {1427--1435},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\thaih\\Zotero\\storage\\WFR9DH3Z\\Sahoo et al. - 2010 - Grain fragmentation and twinning in deformed Zirca.pdf:application/pdf},
