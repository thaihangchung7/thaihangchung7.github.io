	pages = {989},
	file = {Full Text PDF:C\:\\Users\\thaih\\Zotero\\storage\\4RGYAI2C\\Chung et al. - 2025 - Point Defects in MoNbTi-Based Refractory Multi-Principal-Element Alloys.pdf:application/pdf},
