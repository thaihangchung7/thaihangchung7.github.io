	file = {APS Snapshot:C\:\\Users\\thaih\\Zotero\\storage\\T7RL8R7P\\PhysRev.77.html:text/html},
}

@article{tesmer_up_1987,
	title = {Up {Close}: {The} {Ion} {Beam} {Materials} {Laboratory} at {Los} {Alamos} {National} {Laboratory}},
	volume = {12},
	issn = {0883-7694, 1938-1425},
	shorttitle = {Up {Close}},
