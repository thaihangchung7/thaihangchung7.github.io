@article{klemperer_annihilation_1934,
	title = {On the annihilation radiation of the positron},
	volume = {30},
	issn = {1469-8064, 0305-0041},
	url = {https://www.cambridge.org/core/journals/mathematical-proceedings-of-the-cambridge-philosophical-society/article/on-the-annihilation-radiation-of-the-positron/990ABDCD5673452CC2A8B4DB350C5D89},
