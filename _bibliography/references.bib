@article{berghold_imaging_2023,
	title = {Imaging low-energy positron beams in real-time with unprecedented resolution},
	volume = {13},
	copyright = {2023 The Author(s)},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-023-45588-0},
	doi = {10.1038/s41598-023-45588-0},
	abstract = {Particle beams focused to micrometer-sized spots play a crucial role in forefront research using low-energy positrons. Their expedient and wide application, however, requires highly-resolved, fast beam diagnostics. We have developed two different methods to modify a commercial imaging sensor to make it sensitive to low-energy positrons. The first method consists in removing the micro-lens array and Bayer filter from the sensor surface and depositing a phosphor layer in their place. This procedure results in a detector capable of imaging positron beams with energies down to a few tens of eV, or an intensity as low as \$\$\{35\}{\textbackslash},\{{\textbackslash}hbox \{e\}{\textasciicircum}+/{\textbackslash}hbox \{s/mm\}{\textasciicircum}\{2\}\}\$\$when the beam energy exceeds 10 \$\$\{{\textbackslash}hbox \{keV\}\}\$\$. The second approach omits the phosphor deposition; with the resulting device we succeeded in detecting single positrons with energies upwards of \$\$\{6\}{\textbackslash},\{{\textbackslash}hbox \{keV\}\}\$\$and efficiency up to 93\%. The achieved spatial resolution of 0.97 \$\${\textbackslash}upmu {\textbackslash}hbox \{m\}\$\$is unprecedented for real-time positron detectors.},
	language = {en},
	number = {1},
	urldate = {2025-06-28},
	journal = {Sci Rep},
	publisher = {Nature Publishing Group},
	author = {Berghold, Michael and Burwitz, Vassily Vadimovitch and Mathes, Lucian and Hugenschmidt, Christoph and Guatieri, Francesco},
	month = oct,
	year = {2023},
	keywords = {Imaging techniques, interfaces and thin films, Surfaces},
	pages = {18526},
	file = {Full Text PDF:C\:\\Users\\thaih\\Zotero\\storage\\YZK5WLNE\\Berghold et al. - 2023 - Imaging low-energy positron beams in real-time wit.pdf:application/pdf},
}

