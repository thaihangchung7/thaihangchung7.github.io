@article{moskal_positronium_2021,
	title = {Positronium imaging with the novel multiphoton {PET} scanner},
	volume = {7},
	url = {https://www.science.org/doi/10.1126/sciadv.abh4394},
	doi = {10.1126/sciadv.abh4394},
	abstract = {In vivo assessment of cancer and precise location of altered tissues at initial stages of molecular disorders are important diagnostic challenges. Positronium is copiously formed in the free molecular spaces in the patient’s body during positron emission tomography (PET). The positronium properties vary according to the size of inter- and intramolecular voids and the concentration of molecules in them such as, e.g., molecular oxygen, O2; therefore, positronium imaging may provide information about disease progression during the initial stages of molecular alterations. Current PET systems do not allow acquisition of positronium images. This study presents a new method that enables positronium imaging by simultaneous registration of annihilation photons and deexcitation photons from pharmaceuticals labeled with radionuclides. The first positronium imaging of a phantom built from cardiac myxoma and adipose tissue is demonstrated. It is anticipated that positronium imaging will substantially enhance the specificity of PET diagnostics.},
	number = {42},
	urldate = {2025-06-05},
