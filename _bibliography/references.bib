	year = {1997},
	pages = {256--262},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\thaih\\Zotero\\storage\\5W3SCS87\\Ling et al. - 1997 - Positron beam profiling study of the metal-GaAs interface.pdf:application/pdf},
}

