@article{selim_positron_2005,
	title = {Positron lifetime measurements by proton capture},
	volume = {76},
	issn = {0034-6748},
	url = {https://doi.org/10.1063/1.1863772},
	doi = {10.1063/1.1863772},
	abstract = {A positron lifetime spectroscopy (PLS) technique was developed using coincident γ rays induced by proton capture. Proton capture in some light elements induce coincident MeV γ rays, allowing positron lifetime to be measured. One γ quantum provides a start signal for the positron lifetime spectrometer, whereas the other γ quantum bombards the sample under investigation, generating a positron inside it through pair production. The stop signal is obtained from the detection of one of the two 511keV photons emitted from positron annihilation with the sample electrons. This new technique can extend PLS, which is a powerful tool to identify the size and concentration of defects, to thick materials and a broad range of applications. It also eliminates the source contribution from the measured spectra, which may lead to the identification of more defect types in a sample.},
	number = {3},
	urldate = {2025-11-08},
	journal = {Rev. Sci. Instrum.},
	author = {Selim, F. A. and Wells, D. P. and Harmon, J. F.},
